{
  "permissions": {
    "deny": [
      "Bash(docker rm *)",
      "Bash(docker container rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume rm *)",
      "Bash(docker compose down*)",
      "Bash(docker-compose down*)",
      "Bash(docker system prune*)",
      "Bash(dropdb *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git * --no-verify*)",
      "Write(/opt/stacks/**)",
      "Edit(/opt/stacks/**)",
      "Bash(sudo ufw *)",
      "Bash(ufw *)",
      "Bash(sudo tailscale *)",
      "Bash(tailscale up*)",
      "Bash(tailscale down*)",
      "Bash(tailscale set*)",
      "Bash(tailscale logout*)",
      "Bash(sudo systemctl stop docker*)",
      "Bash(sudo systemctl restart docker*)",
      "Bash(sudo systemctl disable docker*)",
      "Bash(sudo systemctl stop ssh*)",
      "Bash(sudo systemctl restart ssh*)",
      "Bash(sudo systemctl disable ssh*)",
      "Bash(sudo systemctl stop tailscaled*)",
      "Bash(sudo systemctl restart tailscaled*)",
      "Bash(systemctl --user stop zellij-main*)",
      "Bash(systemctl --user restart zellij-main*)",
      "Bash(systemctl --user disable zellij-main*)",
      "Bash(docker stop postgres*)",
      "Bash(docker restart postgres*)",
      "Bash(docker kill postgres*)",
      "Bash(docker stop caddy*)",
      "Bash(docker restart caddy*)",
      "Bash(docker kill caddy*)",
      "Bash(docker stop forgejo*)",
      "Bash(docker restart forgejo*)",
      "Bash(docker kill forgejo*)",
      "Bash(docker stop outline*)",
      "Bash(docker restart outline*)",
      "Bash(docker kill outline*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
