#!/usr/bin/env python3
"""vault-snapshot: the read-only vault snapshot claude.ai reads from (M9 P2, widened by M11 P1).

Publishes, hourly, a derived cache of what is already PUSHED to origin/main, outside the vault:
  $SNAPSHOT_DIR/gen-<sha>-s<SCOPE>/   the files; $SNAPSHOT_DIR/current -> gen-<sha>-s<SCOPE> (relative symlink)
The vault-door container mounts $SNAPSHOT_DIR read-only at /snapshot; its read tools (search_notes, read_file)
never see the live vault. Nothing here writes into the vault.

What is published (M11, founder 2026-11-07 "allow literally all"): every top-level folder and root file of
`git archive refs/remotes/origin/main` (pushed content only: no work tree, no local commits), NO deny list, minus
symlinks, hidden files/folders, machine output (1_projects/*/{pull-log,landings,engineering/jobs,engineering/seat}/**,
1_projects/*/agent-ledger*), every other file type, files over the size caps (text 5 MB; images and PDFs 25 MB) and
every file the credential scan flags. Types: text `md txt csv tsv json html tex typ puml yaml yml svg`, images
`png jpg jpeg webp gif`, `pdf`. Anything else is `other-type`.

PDF text (CONTRACT with the door): each PDF gets a sidecar `.text/<vault path>.txt` = the fixed first line
`# pdf text of <vault path>` + "\n" + pdftotext's text verbatim (pages end with "\f"; page n is the n-th "\f"-separated
chunk after the first line). pdftotext runs CONFINED (`systemd-run --user`: no network, read-only, no privilege gain,
memory and time bounded; the PDF goes in on stdin, the text comes out on stdout). A failed extraction writes no
sidecar and keeps the PDF (`pdf-notext`).

Credential scan: gitleaks skips files by extension (`svg pdf png jpg`), by directory (`node_modules`) and by content
sniff (`%PDF-`), so it never reads the published paths. It reads SCAN COPIES instead: every text-type file and every
sidecar, copied as `<n>.txt` with the fixed first line `# scan copy` and no path (a map n -> path turns a hit back into
a path). A hit drops that file; a hit on a sidecar drops the sidecar AND its PDF. A text-type file that is not UTF-8,
holds a NUL or starts with a binary magic is dropped as `fake-binary` first. Images and PDF page pictures are not
scannable (founder item 4).

FAIL CLOSED: a gitleaks hit that cannot be dropped, a missing binary or config, any gitleaks error
(exit 1 without a readable report is an error, not a hit) or a failed archive publishes nothing and
keeps the old `current`. The swap is `ln -s gen-... current.tmp && rename(current.tmp, current)`;
the mounted parent directory is never renamed. Two generations are kept. The generation key carries SCOPE, so a
change of what is published rebuilds at an unchanged sha (bump SCOPE on any such change).

Env (test hooks): VAULT_DIR, SNAPSHOT_DIR, GITLEAKS_BIN, GITLEAKS_CONFIG, PDFTOTEXT_BIN, SNAPSHOT_SCOPE,
EXTRACT_SECONDS, EXTRACT_MEMORY. Prints counts only, never file contents. Exit 0 = published or already current;
1 = nothing published.
"""
import fcntl
import json
import os
import shutil
import stat
import subprocess
import sys
import tarfile
import threading
import time

HOME = os.path.expanduser("~")
VAULT = os.environ.get("VAULT_DIR", os.path.join(HOME, "vault"))
OUT = os.environ.get("SNAPSHOT_DIR", os.path.join(HOME, ".cache", "vault-snapshot"))
GITLEAKS = os.environ.get("GITLEAKS_BIN", os.path.join(HOME, ".local/share/mise/installs/aqua-gitleaks-gitleaks/8.30.1/gitleaks"))
CONFIG = os.environ.get("GITLEAKS_CONFIG", os.path.join(HOME, ".dotfiles/vault/gitleaks.toml"))
REF = "refs/remotes/origin/main"
SCOPE = 2  # M9's narrow scope was, in effect, 1; bump on ANY change of what is published (it is part of the generation key)
TEXT_TYPES = ("md", "txt", "csv", "tsv", "json", "html", "tex", "typ", "puml", "yaml", "yml", "svg")
IMAGE_TYPES = ("png", "jpg", "jpeg", "webp", "gif")
MAX_TEXT = 5_000_000
MAX_BINARY = 25_000_000
SIDECAR_DIR = ".text"
SCAN_LINE = b"# scan copy\n"
PDFTOTEXT = os.environ.get("PDFTOTEXT_BIN", "/usr/bin/pdftotext")
SYSTEMD_RUN = "/usr/bin/systemd-run"
# The confined pdftotext (M11 P0b, measured): no network, read-only everywhere, no privilege gain, bounded memory,
# tasks and time. No writable path at all: the PDF comes in on stdin and the text goes out on stdout (a pipe, never a file:
# LimitFSIZE=0 kills a child that writes to one). MemoryMax and RuntimeMaxSec are added per call.
SANDBOX = (
    "PrivateNetwork=yes", "RestrictAddressFamilies=AF_UNIX", "ProtectSystem=strict", "ProtectHome=yes",
    "InaccessiblePaths=/run", "PrivateTmp=no", "PrivateDevices=yes", "ReadOnlyPaths=/dev/shm", "NoNewPrivileges=yes",
    "ProtectKernelTunables=yes", "ProtectControlGroups=yes", "SystemCallFilter=@system-service",
    "SystemCallArchitectures=native", "MemorySwapMax=0", "TasksMax=16", "LimitFSIZE=0", "LimitCORE=0",
)
# Content magics that make `gitleaks dir` skip a text file (M11 P0b skip set; (offset, bytes)). With the fixed first line
# of the scan copies this list is hygiene, not the filter.
BINARY_MAGICS = (
    (0, b"%PDF-"), (0, b"PK\x03\x04"), (0, b"\x1f\x8b"), (0, b"BZh"), (0, b"\xfd7zXZ\x00"), (0, b"7z\xbc\xaf\x27\x1c"),
    (0, b"Rar!\x1a\x07"), (0, b"\x28\xb5\x2f\xfd"), (0, b"\x7fELF"), (0, b"MZ"), (0, b"\xfe\xed\xfa\xce"),
    (0, b"\xfe\xed\xfa\xcf"), (0, b"\xce\xfa\xed\xfe"), (0, b"\xcf\xfa\xed\xfe"), (0, b"\xca\xfe\xba\xbe"),
    (0, b"SQLite format 3\x00"), (0, b"%!PS"), (0, b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1"), (0, b"\x00asm"),
    (0, b"{\\rtf"), (0, b"Cr24"), (0, b"!<arch>\n"), (0, b"MSCF"), (0, b"FWS"), (0, b"CWS"), (0, b"ZWS"),
    (257, b"ustar"),
)


class Fail(Exception):
    pass


def git(*args, **kw):
    return subprocess.run(["git", "-C", VAULT, *args], **kw)


def machine_output(parts):
    """1_projects/<p>/{pull-log,landings}/**, <p>/engineering/{jobs,seat}/**, <p>/agent-ledger* (P3's list)."""
    if parts[0] != "1_projects" or len(parts) < 3:
        return False
    if parts[2].startswith("agent-ledger"):
        return True
    if parts[2] in ("pull-log", "landings"):
        return len(parts) > 3
    return parts[2] == "engineering" and len(parts) > 4 and parts[3] in ("jobs", "seat")


def ext_of(name):
    return os.path.splitext(name)[1][1:].lower()


def fake_binary(data):
    """A text-type file that is not UTF-8, holds a NUL or starts with a binary magic is not text."""
    if b"\0" in data or any(data[o:o + len(m)] == m for o, m in BINARY_MAGICS):
        return True
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        return True
    return False


def write_new(target, data=None, src=None):
    os.makedirs(os.path.dirname(target), exist_ok=True)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "wb") as f:
        if src is not None:
            shutil.copyfileobj(src, f)
        else:
            f.write(data)
    os.chmod(target, 0o644)


def extract(proc, dest):
    """Stream the archive; write only wanted regular files. Returns counters and the PDF paths."""
    n = dict(files=0, machine=0, hidden=0, symlink=0, oversize=0, other=0, fake=0, notext=0)
    pdfs = []
    tar = tarfile.open(fileobj=proc.stdout, mode="r|")
    for m in tar:
        name = m.name.lstrip("./") if m.name.startswith("./") else m.name
        parts = [p for p in name.split("/") if p]
        if m.isdir() or not parts or ".." in parts or name.startswith("/"):
            continue
        if m.issym() or m.islnk():
            n["symlink"] += 1
            continue
        if not m.isreg():
            continue
        if any(p.startswith(".") for p in parts):
            n["hidden"] += 1
            continue
        if machine_output(parts):
            n["machine"] += 1
            continue
        ext = ext_of(parts[-1])
        text = ext in TEXT_TYPES
        if not (text or ext in IMAGE_TYPES or ext == "pdf") or any(ord(c) < 32 or c == "\x7f" for c in name):
            n["other"] += 1  # a control character in a name would break the sidecar's fixed first line
            continue
        if m.size > (MAX_TEXT if text else MAX_BINARY):
            n["oversize"] += 1
            continue
        target = os.path.join(dest, *parts)
        if text:
            data = tar.extractfile(m).read()
            if fake_binary(data):
                n["fake"] += 1
                continue
            write_new(target, data=data)
        else:
            write_new(target, src=tar.extractfile(m))
            if ext == "pdf":
                pdfs.append("/".join(parts))
        n["files"] += 1
    return n, pdfs


def pdf_text(pdf_path):
    """The confined pdftotext: bytes of text, or None on any failure, limit hit or oversize output."""
    seconds = os.environ.get("EXTRACT_SECONDS", "30")
    memory = os.environ.get("EXTRACT_MEMORY", "512M")
    props = [x for p in (*SANDBOX, f"RuntimeMaxSec={seconds}", f"MemoryMax={memory}") for x in ("-p", p)]
    cmd = [SYSTEMD_RUN, "--user", "--pipe", "--wait", "--collect", *props, "--",
           PDFTOTEXT, "-q", "-enc", "UTF-8", "-", "-"]
    try:
        with open(pdf_path, "rb") as pdf:
            p = subprocess.Popen(cmd, stdin=pdf, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            guard = threading.Timer(int(seconds) + 15, p.kill)  # the unit's RuntimeMaxSec is the real bound
            guard.start()
            try:
                out = p.stdout.read(MAX_TEXT + 1)  # read() returns early only at EOF
                if len(out) > MAX_TEXT:
                    p.kill()
                    out = None
                p.stdout.close()
                rc = p.wait()
            finally:
                guard.cancel()
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    return out if out is not None and rc == 0 else None


def write_sidecars(build, pdfs, counts):
    for rel in pdfs:
        text = pdf_text(os.path.join(build, *rel.split("/")))
        if text is None:
            counts["notext"] += 1
            continue
        body = text.decode("utf-8", "replace").replace("\0", "")
        write_new(os.path.join(build, SIDECAR_DIR, *rel.split("/")) + ".txt", data=f"# pdf text of {rel}\n{body}".encode())


def make_scan_copies(build, scan):
    """Neutral-named copies (`<n>.txt`, fixed first line) of every text-type file and sidecar. Returns {n.txt: path}."""
    os.mkdir(scan, 0o700)
    mapping = {}
    for d, dirs, files in os.walk(build):
        dirs.sort()
        for f in sorted(files):
            if ext_of(f) in TEXT_TYPES:
                path = os.path.join(d, f)
                name = f"{len(mapping)}.txt"
                with open(path, "rb") as src, open(os.path.join(scan, name), "wb") as dst:
                    dst.write(SCAN_LINE)
                    shutil.copyfileobj(src, dst)
                mapping[name] = os.path.relpath(path, build)
    return mapping


def scan_and_drop(build, scan, report, counts):
    """Scan the copies; drop what is flagged (a flagged sidecar drops its PDF too); rescan: the tree must be clean."""
    mapping = make_scan_copies(build, scan)
    try:
        flagged = gitleaks_dir(scan, report)
    finally:
        shutil.rmtree(scan, ignore_errors=True)
    if not flagged:
        return
    dropped = set()
    for path in flagged:
        rel = mapping.get(os.path.basename(path))
        if rel is None:
            raise Fail("gitleaks flagged a file that is not a scan copy")
        if rel.startswith(SIDECAR_DIR + "/"):
            pdf = rel[len(SIDECAR_DIR) + 1:-len(".txt")]
            for victim in (rel, pdf):
                if os.path.isfile(os.path.join(build, victim)):
                    os.unlink(os.path.join(build, victim))
            dropped.add(pdf)
        else:
            os.unlink(os.path.join(build, rel))
            dropped.add(rel)
    counts["files"] -= len(dropped)
    counts["secrets"] = len(dropped)
    make_scan_copies(build, scan)
    try:
        if gitleaks_dir(scan, report):  # dropping must leave a clean tree
            raise Fail("gitleaks still reports a hit after dropping the flagged files")
    finally:
        shutil.rmtree(scan, ignore_errors=True)


def normalise_modes(dest):
    os.chmod(dest, 0o755)
    for d, dirs, _ in os.walk(dest):
        for x in dirs:
            os.chmod(os.path.join(d, x), 0o755)


def gitleaks_dir(dest, report):
    """Run `gitleaks dir`; returns the list of flagged files (absolute, verified inside dest)."""
    if not (os.path.isfile(GITLEAKS) and os.access(GITLEAKS, os.X_OK)):
        raise Fail("gitleaks binary missing")
    if not os.access(CONFIG, os.R_OK):
        raise Fail("gitleaks config unreadable")
    if os.path.lexists(report):
        os.unlink(report)
    cmd = [GITLEAKS, "dir", "--no-banner", "--redact", "--exit-code", "1", "--ignore-gitleaks-allow",
           "--log-level", "error", "--config", CONFIG, "--report-format", "json", "--report-path", report, dest]
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=600, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        raise Fail(f"gitleaks could not run ({type(e).__name__})") from None
    if p.returncode == 0:
        return []
    if p.returncode != 1:
        raise Fail(f"gitleaks exited {p.returncode}")
    # exit 1 means "hit" OR "bad config": only a readable, non-empty report counts as a hit.
    try:
        with open(report) as f:
            findings = json.load(f)
        assert isinstance(findings, list) and findings
        files = set()
        base = os.path.realpath(dest)
        for x in findings:
            path = x["File"]
            path = path if os.path.isabs(path) else os.path.join(dest, path)
            real = os.path.realpath(os.path.dirname(path))
            if real != base and not real.startswith(base + os.sep):
                raise Fail("gitleaks report names a path outside the snapshot")
            files.add(os.path.join(real, os.path.basename(path)))
    except Fail:
        raise
    except Exception:
        raise Fail("gitleaks exited 1 without a readable report") from None
    return sorted(files)


def prune(keep_current):
    gens = [g for g in os.listdir(OUT) if g.startswith("gen-") and g != keep_current]
    gens.sort(key=lambda g: os.stat(os.path.join(OUT, g)).st_mtime, reverse=True)
    for g in gens[1:]:  # current + the newest other = two generations
        shutil.rmtree(os.path.join(OUT, g), ignore_errors=True)


def run():
    os.makedirs(OUT, mode=0o755, exist_ok=True)
    lock = open(os.path.join(OUT, ".lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise Fail("another run holds the lock") from None

    p = git("rev-parse", "-q", "--verify", REF, capture_output=True, text=True)
    sha = p.stdout.strip()
    if p.returncode != 0 or len(sha) < 40:
        raise Fail(f"{REF} not found in {VAULT}")
    scope = int(os.environ.get("SNAPSHOT_SCOPE", SCOPE))
    gen = f"gen-{sha}-s{scope}"
    cur = os.path.join(OUT, "current")
    if os.path.islink(cur) and os.readlink(cur) == gen and os.path.isfile(os.path.join(cur, "SNAPSHOT.md")):
        print(f"vault-snapshot: {sha[:12]} scope {scope} already current")
        return

    for n in os.listdir(OUT):  # leftovers of a killed run
        if n.startswith(".build"):
            path = os.path.join(OUT, n)
            shutil.rmtree(path, ignore_errors=True) if os.path.isdir(path) and not os.path.islink(path) else os.unlink(path)

    build = os.path.join(OUT, f".build-{os.getpid()}")
    scan = os.path.join(OUT, f".build-{os.getpid()}.scan")
    report = os.path.join(OUT, f".build-{os.getpid()}.report.json")
    try:
        if not git("ls-tree", "--name-only", REF, capture_output=True, text=True).stdout.strip():
            raise Fail("the pushed tree is empty")
        os.mkdir(build, 0o755)
        arch = subprocess.Popen(["git", "-C", VAULT, "archive", "--format=tar", REF],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        try:
            counts, pdfs = extract(arch, build)
        finally:
            arch.stdout.close()
        if arch.wait() != 0:
            raise Fail("git archive failed")

        write_sidecars(build, pdfs, counts)
        counts["secrets"] = 0
        scan_and_drop(build, scan, report, counts)
        for d, dirs, files in os.walk(build, topdown=False):  # no empty folders left by drops
            if d != build and not os.listdir(d):
                os.rmdir(d)
        dropped = (counts["machine"] + counts["hidden"] + counts["symlink"] + counts["oversize"] + counts["other"]
                   + counts["fake"] + counts["secrets"])  # pdf-notext is a kept PDF, not a drop

        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        detail = (f"machine-output {counts['machine']}, hidden {counts['hidden']}, symlinks {counts['symlink']}, "
                  f"oversize {counts['oversize']}, other-type {counts['other']}, fake-binary {counts['fake']}, "
                  f"secrets {counts['secrets']}, pdf-notext {counts['notext']}")
        stamp = (
            "# vault snapshot (read-only, derived)\n\n"
            f"sha: {sha}\nscope: {scope}\ngenerated: {now}\nfiles: {counts['files']}\ndropped: {dropped}\n"
            f"dropped_detail: {detail}\n\n"
            "Pushed `origin/main` content only (never the live work tree), rebuilt hourly. Not a record: edits belong in the vault. "
            "`.text/<path>.txt` holds each PDF's extracted text (first line `# pdf text of <path>`, pages end with a form feed); "
            "pdf-notext counts PDFs kept without one.\n"
        )
        with open(os.path.join(build, "SNAPSHOT.md"), "w") as f:
            f.write(stamp)
        os.chmod(os.path.join(build, "SNAPSHOT.md"), 0o644)
        normalise_modes(build)

        final = os.path.join(OUT, gen)
        if os.path.lexists(final):  # an older generation of the same key that is not current
            shutil.rmtree(final)
        os.rename(build, final)
        os.utime(final)
        tmp = os.path.join(OUT, "current.tmp")
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink(gen, tmp)
        os.replace(tmp, cur)  # atomic: a reader sees the old or the new generation, never neither
        prune(gen)

        per = {}
        for top in sorted(os.listdir(final)):
            if top in ("SNAPSHOT.md", SIDECAR_DIR):
                continue
            tp = os.path.join(final, top)
            per[top] = sum(len(fs) for _, _, fs in os.walk(tp)) if os.path.isdir(tp) else 1
        print(f"vault-snapshot: {sha[:12]} scope {scope} published {counts['files']} files "
              + " ".join(f"{k}={v}" for k, v in per.items()) + f"; dropped {dropped} ({detail})")
    finally:
        shutil.rmtree(build, ignore_errors=True)
        shutil.rmtree(scan, ignore_errors=True)
        if os.path.lexists(report):
            os.unlink(report)


if __name__ == "__main__":
    try:
        run()
    except Fail as e:
        print(f"vault-snapshot: nothing published: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"vault-snapshot: nothing published: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(1)
