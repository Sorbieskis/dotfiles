#!/usr/bin/env python3
"""Drop photos from the phone onto the box, for Claude Code to look at.

A terminal SSH session (Termius on the phone) cannot accept an image, so this
serves an upload page on the TAILSCALE IP — private to the tailnet, never
public, same posture as Dockge.

Uploads are grouped into BATCHES — one "tap to pick" selection is one batch —
because the useful unit is rarely a lone photo: it is three screenshots of the
same bug, or a machine plus its rating plate. Each batch is a numbered
directory, so "look at drop 7" names a set, and the shots keep the order you
picked them in.

A batch can carry a NOTE, and the note is the point of the page as much as the
photos are: a phone keyboard beats typing context into a terminal over SSH.
"the save button does nothing on mobile" lands next to the screenshots instead
of being retyped one-handed at a shell prompt.

  ~/drop/0007/note.md        what you typed (absent if you typed nothing)
  ~/drop/0007/1-IMG_x.jpg    photos, numbered in the order you picked them
  ~/drop/latest              symlink -> the newest batch directory
  ~/drop/index.tsv           append-only: batch, ISO time, files, bytes

Uploads are raw PUT bodies, not multipart form data: Python 3.13 removed the
`cgi` module, which was the stdlib's only multipart parser. The page's JS reads
each file and PUTs the bytes, so the server just writes the request body.

Normally runs as a user service (photo-drop.service). Run by hand for a
different port or directory:

  photo-drop --port 9000 --dir ~/somewhere-else
"""
import argparse
import datetime
import html
import http.server
import json
import mimetypes
import os
import pathlib
import re
import shutil
import subprocess
import sys
import threading
from urllib.parse import unquote

DEST: pathlib.Path
INDEX: pathlib.Path
LOCK = threading.Lock()
BATCH = 0
# Client-generated token -> batch dir, so every file from one selection lands
# together. Bounded: a phone left on the page for days must not grow this.
TOKENS: dict[str, pathlib.Path] = {}
TOKEN_CAP = 64

MAX_BYTES = 64 * 1024 * 1024
MAX_NOTE = 8000
SHOWN = 8  # batches rendered on the page
# Raster types served inline; everything else (svg, html, …) → octet-stream.
IMAGE_TYPES = {"image/png", "image/jpeg", "image/gif", "image/webp",
               "image/bmp", "image/tiff", "image/heic", "image/heif",
               "image/avif"}

PAGE = """<!doctype html>
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>drop</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body { margin:0; padding:1.5rem 1rem 3rem; background:#12171c; color:#e6edf3;
         font:16px/1.5 system-ui,-apple-system,sans-serif; }
  header { display:flex; align-items:baseline; justify-content:space-between;
           margin-bottom:1.25rem; }
  h1 { font-size:1rem; margin:0; color:#7fd3e0; letter-spacing:.04em;
       text-transform:uppercase; font-weight:600; }
  .dest { font:12px ui-monospace,monospace; color:#8b98a5; }
  label.pick { display:block; padding:2rem 1rem; text-align:center; cursor:pointer;
         border:1px dashed #3a4753; background:#161c22; font-weight:500; }
  label.pick:active { background:#1b232b; border-color:#7fd3e0; }
  label.pick span { color:#7fd3e0; }
  input[type=file] { display:none; }
  #log { margin:.75rem 0 0; font:13px/1.8 ui-monospace,monospace; }
  .ok { color:#7fc7a3; } .err { color:#e5806b; } .pend { color:#8b98a5; }
  #notebox { display:none; margin-top:1rem; }
  #notebox.on { display:block; }
  textarea { width:100%; min-height:5.5rem; padding:.7rem; background:#161c22;
             color:#e6edf3; border:1px solid #3a4753; border-radius:0;
             font:15px/1.5 system-ui,sans-serif; resize:vertical; }
  textarea:focus { outline:none; border-color:#7fd3e0; }
  .row { display:flex; gap:.5rem; margin-top:.5rem; align-items:center; }
  button { flex:0 0 auto; padding:.6rem 1.1rem; background:#7fd3e0; color:#0d1216;
           border:0; font:600 14px system-ui,sans-serif; cursor:pointer; }
  button:disabled { background:#3a4753; color:#8b98a5; }
  .hint { font:12px ui-monospace,monospace; color:#8b98a5; }
  h2 { font-size:.75rem; text-transform:uppercase; letter-spacing:.08em;
       color:#8b98a5; font-weight:600; margin:2rem 0 .75rem;
       border-top:1px solid #232c35; padding-top:1rem; }
  .batch { margin-bottom:1.25rem; }
  .bhead { display:flex; align-items:baseline; gap:.5rem; margin-bottom:.4rem; }
  .bhead b { color:#7fd3e0; font:600 13px ui-monospace,monospace; }
  .bhead .meta { font:11px ui-monospace,monospace; color:#5c6875; }
  .del { margin-left:auto; flex:0 0 auto; background:none; border:0;
         color:#5c6875; font:16px/1 system-ui; cursor:pointer; padding:.1rem .4rem; }
  .del:active { color:#e5806b; }
  .bnote { font-size:14px; color:#c9d4de; margin:.1rem 0 .5rem;
           border-left:2px solid #3a4753; padding-left:.6rem; white-space:pre-wrap; }
  .shots { display:grid; grid-template-columns:repeat(auto-fill,minmax(96px,1fr));
           gap:.4rem; }
  .shots img { width:100%; aspect-ratio:1; object-fit:cover; display:block;
               background:#161c22; border:1px solid #232c35; }
  .empty { color:#5c6875; font:13px ui-monospace,monospace; }
</style>
<header>
  <h1>drop</h1>
  <div class="dest">__DEST__</div>
</header>

<label class="pick">
  <input type="file" accept="image/*" multiple onchange="send(this.files)">
  tap to pick <span>photos</span>
</label>
<div id="log"></div>

<div id="notebox">
  <textarea id="note" placeholder="what am I looking at? (optional)"></textarea>
  <div class="row">
    <button id="save" onclick="saveNote()">save note</button>
    <span class="hint" id="notehint"></span>
  </div>
</div>

<h2>recent</h2>
<div id="grid">__RECENT__</div>

<script>
const log = document.getElementById('log');
const notebox = document.getElementById('notebox');
const hint = document.getElementById('notehint');
let token = null, batchNo = null;

function newToken() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

async function send(files) {
  if (!files.length) return;
  // One selection = one batch. A fresh token each time, so picking again after
  // saving a note starts a new group rather than appending to the old one.
  token = newToken();
  let ok = 0;
  for (const f of files) {
    const line = document.createElement('div');
    line.className = 'pend';
    line.textContent = '\\u00b7\\u00b7\\u00b7 ' + f.name;
    log.prepend(line);
    try {
      const r = await fetch('/u/' + token + '/' + encodeURIComponent(f.name),
                            { method: 'PUT', body: f });
      const t = (await r.text()).trim();
      line.className = r.ok ? 'ok' : 'err';
      line.textContent = (r.ok ? '\\u2713 ' : '\\u2717 ') + t;
      if (r.ok) { ok++; batchNo = t.split(' ')[0]; }
    } catch (e) {
      line.className = 'err';
      line.textContent = '\\u2717 ' + f.name + ' \\u2014 ' + e;
    }
  }
  if (ok) {
    notebox.classList.add('on');
    hint.textContent = 'batch ' + batchNo;
    document.getElementById('note').focus();
    refresh();
  }
}

async function saveNote() {
  const el = document.getElementById('note'), btn = document.getElementById('save');
  if (!token || !el.value.trim()) return;
  btn.disabled = true;
  try {
    const r = await fetch('/note/' + token, { method: 'PUT', body: el.value });
    hint.textContent = r.ok ? 'saved to batch ' + batchNo : 'failed';
    if (r.ok) { el.value = ''; notebox.classList.remove('on'); refresh(); }
  } catch (e) { hint.textContent = 'failed: ' + e; }
  btn.disabled = false;
}

async function refresh() {
  try {
    const r = await fetch('/api/list');
    const b = await r.json();
    document.getElementById('grid').innerHTML = b.map(x =>
      '<div class="batch"><div class="bhead"><b>' + x.batch + '</b>' +
      '<span class="meta">' + x.files.length + ' shot' +
      (x.files.length === 1 ? '' : 's') + ' \\u00b7 ' + x.when + '</span>' +
      '<button class="del" data-b="' + x.batch + '" onclick="delBatch(this)">\\u2715</button>' +
      '</div>' +
      (x.note ? '<div class="bnote">' + esc(x.note) + '</div>' : '') +
      '<div class="shots">' + x.files.map(f =>
        '<img loading="lazy" src="/f/' + x.batch + '/' + encodeURIComponent(f) + '">'
      ).join('') + '</div></div>'
    ).join('') || '<div class="empty">nothing yet</div>';
  } catch (e) { /* page still works without the refresh */ }
}
async function delBatch(el) {
  // data-b + this, not an inline quoted arg: keeps the batch id out of the
  // onclick string entirely, so no quote-escaping to get wrong.
  const n = el.dataset.b;
  if (!confirm('Delete batch ' + n + '? This cannot be undone.')) return;
  try {
    const r = await fetch('/b/' + n, { method: 'DELETE' });
    if (r.ok) refresh(); else alert('delete failed: ' + (await r.text()));
  } catch (e) { alert('delete failed: ' + e); }
}
function esc(s) {
  return s.replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
}
</script>
"""


def safe(name, fallback="image"):
    """Filenames from a client are hostile input.

    basename() then a character whitelist: a traversal like ../../.ssh/id_ed25519
    would otherwise be a write primitive for anyone on the tailnet.
    """
    raw = os.path.basename(unquote(name))
    return re.sub(r"[^A-Za-z0-9._-]", "_", raw)[-72:].lstrip(".") or fallback


def batches(limit=SHOWN):
    """Newest-first view, read off the directories rather than the index.

    The files on disk are the truth, so a batch you delete disappears from the
    page instead of leaving dead thumbnails behind.
    """
    out = []
    for d in DEST.iterdir():
        if not d.is_dir() or not re.fullmatch(r"\d{4,}", d.name):
            continue
        shots = sorted((p.name for p in d.iterdir()
                        if p.is_file() and p.name != "note.md"),
                       key=lambda n: (int(m.group(1)) if (m := re.match(r"(\d+)-", n)) else 0, n))
        note = ""
        note_path = d / "note.md"
        if note_path.exists():
            note = note_path.read_text(errors="replace")[:MAX_NOTE]
        when = datetime.datetime.fromtimestamp(d.stat().st_mtime).strftime("%H:%M")
        out.append({"batch": d.name, "files": shots, "note": note, "when": when})
    out.sort(key=lambda b: b["batch"], reverse=True)
    return out[:limit]


def batch_for(token):
    """Map a client token to a batch dir, allocating one on first sight."""
    global BATCH
    with LOCK:
        if token in TOKENS:
            return TOKENS[token]
        BATCH += 1
        d = DEST / f"{BATCH:04d}"
        d.mkdir(exist_ok=True)
        # Record the number the instant it is minted, not on first upload. The
        # index is the durable memory the boot-time counter recovers from, and a
        # batch can exist with a note but zero photos (or a PUT can error after
        # this point) — those never reach the /u/ index append. Without this
        # line, deleting such a batch and restarting hands its number out again,
        # so "batch N" would name a different set of photos. (Reviewer #1.)
        with INDEX.open("a") as fh:
            fh.write(f"{d.name}\t{datetime.datetime.now().isoformat(timespec='seconds')}"
                     f"\talloc\t0\n")
        TOKENS[token] = d
        if len(TOKENS) > TOKEN_CAP:
            for k in list(TOKENS)[:-TOKEN_CAP]:
                TOKENS.pop(k, None)

        link, tmp = DEST / "latest", DEST / ".latest.tmp"
        tmp.unlink(missing_ok=True)
        tmp.symlink_to(d.name)
        tmp.replace(link)  # atomic: `latest` is never briefly missing
        return d


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "photo-drop"
    # Socket timeout (honored by StreamRequestHandler): a client that promises N
    # bytes in Content-Length, sends fewer, and never closes would otherwise
    # block this worker thread forever in rfile.read(). This is not just an
    # attacker case — a phone that loses signal mid-upload sends the header then
    # goes silent, no FIN. Without this, that worker hangs (holding up to 64 MB)
    # until TCP eventually gives up, minutes later, on a RAM-tight box.
    timeout = 30

    def _reply(self, code, body, ctype="text/plain; charset=utf-8"):
        raw = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        # Stored bytes are the raw upload — never let a browser sniff a
        # .html/.svg upload into an executable type on this origin (see /f/).
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        try:
            self.wfile.write(raw)
        except BrokenPipeError:
            pass  # phone navigated away mid-thumbnail; not worth a traceback

    def _body(self, cap):
        """Read the request body. Returns (bytes, None) or (None, (code, msg)).

        A structured error, NOT a human string the caller string-matches on:
        the old `err != "over 64 MB"` compare silently downgraded a 413 to 400
        the moment the size limit was anything but exactly 64 MB.
        """
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            return None, (400, "bad length")
        if length <= 0:
            return None, (400, "empty")
        if length > cap:
            return None, (413, "too large")
        remaining, chunks = length, []
        try:
            while remaining:
                chunk = self.rfile.read(min(remaining, 1 << 16))
                if not chunk:
                    return None, (400, "truncated upload")
                chunks.append(chunk)
                remaining -= len(chunk)
        except OSError:
            # socket timeout (see Handler.timeout) or a reset mid-body.
            return None, (408, "upload timed out")
        return b"".join(chunks), None

    def do_GET(self):
        if self.path == "/":
            # Plain .replace(), NOT %-formatting or .format(): the template is
            # CSS + JS, so it is full of `width:100%` and `{ }` that both of
            # those would try to interpret. (It did — `%;` raised ValueError on
            # every page render while uploads kept working, since PUT never
            # touches this path.)
            page = (PAGE
                    .replace("__DEST__", html.escape(
                        str(DEST).replace(str(pathlib.Path.home()), "~")))
                    .replace("__RECENT__", render(batches())))
            return self._reply(200, page, "text/html; charset=utf-8")

        if self.path == "/api/list":
            return self._reply(200, json.dumps(batches()), "application/json")

        if self.path.startswith("/f/"):
            parts = self.path[3:].split("/")
            if len(parts) != 2:
                return self._reply(404, "not found")
            path = DEST / safe(parts[0]) / safe(parts[1])
            # resolve() before the parent check: a symlink pointing outside the
            # drop dir would otherwise serve arbitrary files to the tailnet.
            if not path.is_file() or not path.resolve().is_relative_to(DEST.resolve()):
                return self._reply(404, "not found")
            # Allowlist of RASTER image types only. The stored bytes are the raw
            # upload, so an uploaded .html or .svg would otherwise be served with
            # an executable content-type on this origin; svg counts as image/* so
            # a startswith("image/") test would pass it. Anything not on the list
            # falls back to octet-stream (an inert download), and nosniff (in
            # _reply) stops the browser second-guessing that. (Reviewer #4.)
            guessed = mimetypes.guess_type(path.name)[0]
            ctype = guessed if guessed in IMAGE_TYPES else "application/octet-stream"
            return self._reply(200, path.read_bytes(), ctype)

        self._reply(404, "not found")

    def do_PUT(self):
        if self.path.startswith("/u/"):
            parts = self.path[3:].split("/", 1)
            if len(parts) != 2:
                return self._reply(400, "bad path")
            token, name = safe(parts[0], "t"), safe(parts[1])

            body, err = self._body(MAX_BYTES)
            if err:
                return self._reply(*err)

            d = batch_for(token)
            with LOCK:
                # Re-check under the lock: a DELETE could have rmtree'd this
                # batch in the window after batch_for released the lock. delete
                # also holds LOCK, so once we hold it the dir cannot vanish
                # mid-iterdir — the guard turns a would-be 500 into a clean 409.
                if not d.is_dir():
                    return self._reply(409, "batch was deleted")
                n = sum(1 for p in d.iterdir() if p.name != "note.md") + 1
                path = d / f"{n}-{name}"
                path.write_bytes(body)
                with INDEX.open("a") as fh:
                    fh.write(f"{d.name}\t{datetime.datetime.now().isoformat(timespec='seconds')}"
                             f"\t{path.name}\t{len(body)}\n")
            print(f"  [{d.name}] {path.name}  ({len(body) // 1024} KB)", flush=True)
            return self._reply(200, f"{d.name} — {name}")

        if self.path.startswith("/note/"):
            token = safe(self.path[6:], "t")
            body, err = self._body(MAX_NOTE)
            if err:
                return self._reply(*err)
            # Note before photos is legal: this allocates the batch either way.
            d = batch_for(token)
            with LOCK:
                # Same race guard as /u/: a concurrent DELETE could have removed
                # the dir; write_bytes into a missing parent would 500. Under the
                # lock the dir is stable. (Reviewer #5.)
                if not d.is_dir():
                    return self._reply(409, "batch was deleted")
                (d / "note.md").write_bytes(body)
            print(f"  [{d.name}] note ({len(body)} bytes)", flush=True)
            return self._reply(200, f"{d.name} note saved")

        self._reply(404, "not found")

    def do_DELETE(self):
        if self.path.startswith("/b/"):
            ok, msg = delete_batch(safe(self.path[3:], ""))
            return self._reply(200 if ok else 404, msg)
        self._reply(404, "not found")

    def log_message(self, *a):
        pass  # the prints above are the only output worth having


def heal_latest():
    """Point `latest` at the newest surviving batch, or drop it if none remain.

    A dangling symlink is worse than a missing one — it reads as 'there is a
    newest' until something opens it. `link.exists()` follows the symlink, so it
    is False exactly when `latest` is dangling or absent; a still-valid `latest`
    (an older batch was deleted, not the newest) is left untouched.
    """
    link = DEST / "latest"
    if link.exists():
        return
    link.unlink(missing_ok=True)
    if surviving := batches(limit=1):
        link.symlink_to(surviving[0]["batch"])


def delete_batch(name):
    """Delete a whole batch directory. Returns (ok, message).

    Batch-level, not shot-level: the batch is the unit everywhere else — one
    pick, one number, one note — so it is the unit you clear too. The number is
    NOT reclaimed: index.tsv is append-only, so `main()` recovers the counter
    past it and a deleted batch's number is never handed out again. That is what
    keeps 'batch 7' meaning one thing for the life of the drop dir.
    """
    if not re.fullmatch(r"\d{4,}", name):
        return False, "bad batch"
    d = DEST / name
    # resolve() inside DEST: a crafted name must not rmtree outside the drop dir.
    if not d.is_dir() or not d.resolve().is_relative_to(DEST.resolve()):
        return False, "not found"
    with LOCK:
        shutil.rmtree(d)
        # Forget any client tokens that pointed here, or a trailing note PUT
        # would silently recreate the directory we just deleted.
        for k, v in list(TOKENS.items()):
            if v == d:
                TOKENS.pop(k, None)
        heal_latest()
    print(f"  [{name}] deleted", flush=True)
    return True, f"{name} deleted"


def render(items):
    if not items:
        return '<div class="empty">nothing yet</div>'
    out = []
    for b in items:
        shots = "".join(
            f'<img loading="lazy" src="/f/{html.escape(b["batch"])}/{html.escape(f)}">'
            for f in b["files"])
        note = (f'<div class="bnote">{html.escape(b["note"])}</div>'
                if b["note"] else "")
        plural = "" if len(b["files"]) == 1 else "s"
        out.append(
            f'<div class="batch"><div class="bhead"><b>{html.escape(b["batch"])}</b>'
            f'<span class="meta">{len(b["files"])} shot{plural} · {b["when"]}</span>'
            f'<button class="del" data-b="{html.escape(b["batch"])}" '
            f'onclick="delBatch(this)">✕</button></div>'
            f'{note}<div class="shots">{shots}</div></div>')
    return "".join(out)


def tailscale_ip():
    try:
        out = subprocess.run(["tailscale", "ip", "-4"],
                             capture_output=True, text=True, timeout=5)
        ip = out.stdout.strip().split("\n")[0]
        if ip:
            return ip
    except Exception:
        pass
    return "127.0.0.1"


def main():
    global DEST, INDEX, BATCH
    ap = argparse.ArgumentParser(description="phone -> box photo drop")
    ap.add_argument("--port", type=int, default=8123)
    ap.add_argument("--dir", default="~/drop")
    ap.add_argument("--bind", default=None, help="default: the Tailscale IP")
    args = ap.parse_args()

    DEST = pathlib.Path(args.dir).expanduser().resolve()
    DEST.mkdir(parents=True, exist_ok=True)
    INDEX = DEST / "index.tsv"

    # Recover the counter from the directories AND the append-only index, taking
    # the higher. Directories alone would reuse a number after you delete a
    # batch, so "look at drop 3" could later mean a different set of photos.
    nums = [int(d.name) for d in DEST.iterdir()
            if d.is_dir() and re.fullmatch(r"\d{4,}", d.name)]
    if INDEX.exists():
        nums += [int(h) for line in INDEX.read_text().splitlines()
                 if (h := line.split("\t", 1)[0]).isdigit()]
    BATCH = max(nums, default=0)

    # A batch deleted while the service was down (or the newest one deleted)
    # leaves `latest` dangling; fix it at boot. Same routine the delete path uses.
    heal_latest()

    bind = args.bind or tailscale_ip()
    try:
        srv = http.server.ThreadingHTTPServer((bind, args.port), Handler)
    except OSError as e:
        sys.exit(f"cannot bind {bind}:{args.port} — {e}")

    print(f"drop page:  http://{bind}:{args.port}")
    print(f"saving to:  {DEST}  (next batch: {BATCH + 1:04d})")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped.")


if __name__ == "__main__":
    main()
