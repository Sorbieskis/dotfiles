#!/usr/bin/env python3
"""lab-clean <slug> [--dry-run | --yes]

Remove ONE lab slug's own docker leftovers. Seats are denied `docker rm`/`rmi`; this script is
their single allowed way to clean up, so it is deliberately narrow and fails closed.

  containers: label tier=lab AND name starts `lab-<slug>-` (both, re-read from docker right before each removal).
  images:     tag is `<slug>`, `<slug>-*`, `lab-<slug>` or `lab-<slug>-*` (never `latest`, never untagged),
              AND no container (any tier) uses the image, AND no compose file under /opt/stacks
              references the image's repo, id or digest.

The slug is `m<n>` or a dated lab folder `YYYY-MM-name`; milestone numbers are per repo, so read the dry run first.
Default is a dry run. `--yes` removes. Nothing is ever forced (`rmi` without -f); containers go by id.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

STACKS = Path("/opt/stacks")
# a milestone (`m11`) or a dated lab folder (`2026-11-door-lab`): nothing broader. Milestone numbers are per repo,
# so `m11` also matches another repo's `lab-m11-*`: read the dry run before --yes.
SLUG_RE = re.compile(r"m[0-9]+|20[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*")
USAGE = "usage: lab-clean <slug> [--dry-run | --yes]"


class Refuse(Exception):
    pass


def check_slug(s):
    if len(s) > 60 or not SLUG_RE.fullmatch(s):
        raise Refuse(f"refused: {s!r} is not a milestone (m11) or a dated lab slug (2026-11-name)")
    return s


def parse_args(argv):
    slug, yes, dry = None, False, False
    for a in argv:
        if a == "--yes":
            yes = True
        elif a == "--dry-run":
            dry = True
        elif a.startswith("-"):
            raise Refuse(f"refused: unknown option {a!r}\n{USAGE}")
        elif slug is None:
            slug = a
        else:
            raise Refuse(f"refused: one slug only, got a second argument {a!r}\n{USAGE}")
    if slug is None:
        raise Refuse(USAGE)
    if yes and dry:
        raise Refuse("refused: --yes and --dry-run together")
    return check_slug(slug), yes


def docker(*args):
    r = subprocess.run(["docker", *args], capture_output=True, text=True)
    if r.returncode != 0:
        raise Refuse(f"docker {' '.join(args[:2])} failed: {r.stderr.strip()[:200]}")
    return r.stdout


def inspect(*ids):
    """JSON from `docker container inspect`: labels may hold tabs and newlines, so never split text."""
    out = []
    for c in json.loads(docker("container", "inspect", *ids)):
        out.append((c["Id"], c["Name"].lstrip("/"), (c["Config"].get("Labels") or {}).get("tier", ""), c["Image"]))
    return out


def containers():
    """Every container, any tier: (full id, name, tier label, image id)."""
    ids = docker("container", "ls", "-a", "-q", "--no-trunc").split()
    return inspect(*ids) if ids else []


def pick_containers(rows, slug):
    return [r for r in rows if r[2] == "lab" and r[1].startswith(f"lab-{slug}-")]


def tag_matches(tag, slug):
    if tag in ("", "<none>", "latest"):
        return False
    for base in (slug, f"lab-{slug}"):
        if tag == base or tag.startswith(base + "-"):
            return True
    return False


def repo_of(ref):
    """`docker.io/library/postgres:16@sha256:..` -> `postgres`; a registry host stays."""
    ref = ref.split("@")[0]
    if ":" in ref.rsplit("/", 1)[-1]:
        ref = ref.rsplit(":", 1)[0]
    for pre in ("docker.io/", "library/"):
        if ref.startswith(pre):
            ref = ref[len(pre):]
    return ref


IMAGE_LINE = re.compile(r"^\s*(?:-\s*)?image:\s*[\"']?([A-Za-z0-9][^\s\"'#]*)[\"']?\s*(?:#.*)?$")


def prod_refs(stacks):
    """(repos, text) of every .yml/.yaml under `stacks` (symlinks followed). Fails closed on anything
    unreadable, any interpolated `image:` and any line that mentions `image` but is not a plain
    `image: ref` scalar (alias, folded, flow or quoted-key forms); an absent /opt/stacks has none."""
    if not os.path.lexists(stacks):
        return set(), ""
    if not stacks.is_dir():
        raise Refuse(f"refused: {stacks} exists but is not a readable directory (broken link?)")

    def unreadable(e):
        raise Refuse(f"refused: cannot read {e.filename} ({e.strerror}); image removal needs every compose file")

    repos, text = set(), []
    for root, _, files in os.walk(stacks, onerror=unreadable, followlinks=True):
        for name in sorted(files):
            p = Path(root) / name
            if name.startswith(".env") or p.suffix not in (".yml", ".yaml"):
                continue
            try:
                body = p.read_text()
            except (OSError, UnicodeDecodeError) as e:
                raise Refuse(f"refused: cannot read {p} ({e}); image removal needs every compose file")
            text.append(body)
            for line in body.splitlines():
                if line.lstrip().startswith("#") or not re.search(r"\bimage\b", line):
                    continue
                m = IMAGE_LINE.match(line)
                if not m or "$" in m.group(1):
                    raise Refuse(f"refused: {p} has an image line I cannot read plainly ({line.strip()[:60]!r}); "
                                 "cannot tell which repos are prod")
                repos.add(repo_of(m.group(1)))
    return repos, "\n".join(text)


def images(slug, stacks):
    """Candidate (ref, id) pairs by tag rule, before the in-use / prod filters."""
    fmt = "{{.ID}}\t{{.Repository}}\t{{.Tag}}"
    out = []
    for line in docker("image", "ls", "--no-trunc", "--format", fmt).splitlines():
        iid, repo, tag = line.split("\t")
        repo = repo_of(repo)
        if repo != "<none>" and tag_matches(tag, slug):
            out.append((f"{repo}:{tag}", iid, repo))
    return out


def image_digests(iid):
    out = docker("image", "inspect", "--format", '{{range .RepoDigests}}{{.}} {{end}}', iid).split()
    return [d.split("@", 1)[1] for d in out if "@" in d]


def plan(slug, stacks=STACKS):
    rows = containers()
    doomed = pick_containers(rows, slug)
    keep_ids = {r[0] for r in doomed}
    in_use = {r[3] for r in rows if r[0] not in keep_ids}
    cand = images(slug, stacks)
    imgs, skipped = [], []
    if cand:
        repos, text = prod_refs(stacks)
        for ref, iid, repo in cand:
            why = None
            if iid in in_use:
                why = "in use by a container"
            elif repo in repos:
                why = "repo is in a prod compose"
            elif iid in text or ref in text or any(d in text for d in image_digests(iid)):
                why = "a prod compose references it"
            (skipped if why else imgs).append((ref, iid) if not why else (ref, why))
    return doomed, imgs, skipped


def main(argv, stacks=STACKS):
    try:
        slug, yes = parse_args(argv)
        doomed, imgs, skipped = plan(slug, stacks)
    except Refuse as e:
        print(f"lab-clean: {e}", file=sys.stderr)
        return 2
    for c in doomed:
        print(f"container {c[1]}")
    for ref, _ in imgs:
        print(f"image {ref}")
    for ref, why in skipped:
        print(f"kept image {ref} ({why})")
    n, m = len(doomed), len(imgs)
    if not yes:
        print(f"lab-clean {slug}: would remove {n} container(s), {m} image(s) (dry run; --yes removes)")
        return 0
    try:
        for c in doomed:
            # re-read the container right before removal: same id, still tier=lab, still this slug
            now = inspect(c[0])
            if len(now) != 1 or now[0][0] != c[0] or now[0][2] != "lab" or not now[0][1].startswith(f"lab-{slug}-"):
                raise Refuse(f"refused: container {c[1]} changed since the plan; nothing more removed")
            docker("rm", "-f", c[0])
        for ref, _ in imgs:
            # no -f: docker itself refuses an image a container still uses
            docker("rmi", ref)
    except Refuse as e:
        print(f"lab-clean: {e}", file=sys.stderr)
        return 1
    print(f"lab-clean {slug}: removed {n} container(s), {m} image(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
