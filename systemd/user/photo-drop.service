[Unit]
Description=photo-drop — phone-to-box image upload page on the tailnet
# tailscaled is a SYSTEM unit, so this user unit cannot order itself after it.
# The script therefore POLLS for the tailnet address for 60s and exits non-zero
# if it never appears, which Restart=always then retries. It must never fall
# back to 127.0.0.1: a wrongly-bound server does not exit, so nothing restarts
# it (2026-09-01 — the page was dead on the tailnet for a day after a reboot).
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/photo-drop
# Without this, stdout to the journal is block-buffered, so `journalctl` shows
# nothing until the buffer fills — which reads exactly like a hung service.
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
# The box auto-reboots ~04:00 for unattended upgrades; this is what makes the
# drop page survive it without anyone logging in (linger is enabled for dima).

[Install]
WantedBy=default.target
