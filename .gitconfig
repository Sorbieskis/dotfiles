[user]
	email = ds.suchanka@gmail.com
	name = Sorbieskis
# Git Credential Manager lives on Windows and is reached from WSL via /mnt/c.
# Guard with `test -x` so the helper only runs where that binary actually
# exists — on native Linux (e.g. the VPS) it no-ops instead of crashing with
# "git-credential-manager.exe: not found". On Linux, use SSH remotes for GitHub
# (git@github.com:...), which don't need a credential helper at all.
[credential]
	helper = "!gcm='/mnt/c/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/TeamFoundation/Team Explorer/Git/mingw64/bin/git-credential-manager.exe'; test -x \"$gcm\" && exec \"$gcm\""
# git-delta for diffs/pager. Falls back gracefully (|| less / || cat) on any
# machine where delta isn't installed, so this stays safe across WSL + the VPS.
[core]
	pager = delta 2>/dev/null || less
[interactive]
	diffFilter = delta --color-only 2>/dev/null || cat
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
# Work identity for ~/dev/asml/ — MUST stay last: includes apply in order and the
# last writer wins, so moving this above [user] would let the personal email win
# inside work repos. A missing ~/.gitconfig-asml is silently ignored by git, so
# this stays inert (not broken) on machines without the work checkout — which is
# why the file itself is NOT tracked here.
# Trailing slash matters: it matches every repo BELOW the directory.
[includeIf "gitdir:~/dev/asml/"]
	path = ~/.gitconfig-asml
# Global (NOT directory-scoped) on purpose: this is the only rewrite that can fire
# during `git clone`, where the includeIf above cannot — a clone has no gitdir yet.
# Narrowed to the dsuchank/* namespace so it can never touch Sorbieskis repos, and
# git prefers the LONGEST matching insteadOf, so it also wins over the broader rule
# in ~/.gitconfig-asml without conflicting with it.
# Net effect: `git clone git@github.com:dsuchank/foo` picks the work key anywhere,
# with no alias to remember.
[url "git@github-asml:dsuchank/"]
	insteadOf = git@github.com:dsuchank/
	insteadOf = ssh://git@github.com/dsuchank/
	insteadOf = https://github.com/dsuchank/
